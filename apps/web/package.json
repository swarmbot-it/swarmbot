{
    "name": "web",
    "version": "1.0.3",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build --base-href /app/",
        "watch": "ng build --watch --configuration development",
        "test": "ng test --no-watch",
        "test:watch": "ng test",
        "test:e2e": "playwright test",
        "test:e2e:k8s": "playwright test --config playwright.k8s.config.js",
        "test:e2e:ui": "playwright test --ui",
        "postinstall": "playwright install chromium",
        "lint": "tsc -p tsconfig.app.json --noEmit && ng lint",
        "docs": "compodoc -c compodoc.json",
        "docs:serve": "compodoc -c compodoc.json -s -o"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.1.2",
        "@angular/cdk": "^22.1.2",
        "@angular/common": "^22.1.2",
        "@angular/compiler": "^22.1.2",
        "@angular/core": "^22.1.2",
        "@angular/forms": "^22.1.2",
        "@angular/platform-browser": "^22.1.2",
        "@angular/router": "^22.1.2",
        "@apollo/client": "^4.2.11",
        "@jsverse/transloco": "^8.4.0",
        "@openng/optimus-ui": "2.0.0-rc.0",
        "@openng/optimus-ui-themes": "2.0.0-rc.0",
        "apollo-angular": "^14.1.0",
        "graphql": "^16.14.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.16.2"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^22.1.4",
        "@angular-eslint/builder": "22.1.0",
        "@angular/cli": "^22.1.4",
        "@angular/compiler-cli": "^22.1.2",
        "@compodoc/compodoc": "^2.0.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.1",
        "angular-eslint": "22.1.0",
        "eslint": "^10.3.0",
        "jsdom": "^29.1.1",
        "typescript": "~6.0.0",
        "typescript-eslint": "8.67.0"
    }
}
